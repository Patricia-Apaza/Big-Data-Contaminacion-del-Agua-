   "pluginId": "prometheus",
   "pluginName": "Prometheus"
  }
 ],
 "title": "AquaVigia U2 USGS (Equipo 02)",
 "uid": "aquavigia-u2-usgs",
 "tags": [
  "aquavigia",
  "u2",
  "usgs"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 2,
 "refresh": "30s",
 "time": {
  "from": "now-3h",
  "to": "now"
 },
 "description": "Pipeline en tiempo real con datos USGS: dos dimensiones (Patricia, Jhenderson).",
 "panels": [
  {
   "type": "row",
   "title": "Patricia Apaza: temperatura y oxigeno disuelto",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": [],
   "id": 1,
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   }
  },
  {
   "type": "stat",
   "title": "Eventos USGS procesados",
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "expr": "usgs_eventos_total{integrante=\"patricia\"}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "id": 2,
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   }
  },
  {
   "type": "stat",
   "title": "Retraso de publicacion (min)",
   "gridPos": {
    "x": 6,
    "y": 1,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "expr": "usgs_retraso_min{integrante=\"patricia\"}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "m",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 60
       },
       {
        "color": "red",
        "value": 85
       }
      ]
     }
    },
    "overrides": []
   },
   "id": 3,
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "options": {
    "colorMode": "value",
    "graphMode": "area"
   },
   "description": "Verde hasta 60 min, naranja hasta 85, rojo desde 85 min: el watermark elegido de Spark (85 min). Si el retraso lo supera, se descartarian datos."
  },
  {
   "type": "stat",
   "title": "Total ordenes de inspeccion",
   "gridPos": {
    "x": 12,
    "y": 1,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "expr": "usgs_alertas_total{integrante=\"patricia\"}",
