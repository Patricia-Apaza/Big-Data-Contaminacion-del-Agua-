     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "refId": "A",
     "expr": "usgs_ultimo_valor{integrante=\"patricia\", variable=\"temperatura_c\"}",
     "legendFormat": "{{estacion}} real"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "refId": "B",
     "expr": "usgs_pronostico_1h{integrante=\"patricia\", variable=\"temperatura_c\"}",
     "legendFormat": "{{estacion}} pronostico"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "lineWidth": 2,
      "showPoints": "never"
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byRegexp",
       "options": ".*pronostico"
      },
      "properties": [
       {
        "id": "custom.lineStyle",
        "value": {
         "fill": "dash",
         "dash": [
          8,
          6
         ]
        }
       },
       {
        "id": "custom.lineWidth",
        "value": 1
       }
      ]
     }
    ]
   },
   "description": "Linea continua: lectura real. Linea punteada: lo que el modelo espera dentro de 1 hora.",
